import uproot
import awkward as ak
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import random
import matplotlib.colors as mcolors


fname = "NuE_CC_2603_noFar_noShield_Pandora_Cheated_PaigeFixProper.root"

file = uproot.open(fname)
tree = file["LArRecoND"]
leaves = tree.arrays()
mcvars_mom = ["mcPx","mcPy","mcPz","mcPDG","mcNuE"]
mcDF = ak.to_dataframe(tree.arrays(mcvars_mom, library="ak"))
p = np.sqrt(mcDF["mcPx"]**2 +mcDF["mcPy"]**2 +mcDF["mcPz"]**2)

mcDF["tru_xhat"] = mcDF["mcPx"] / p
mcDF["tru_yhat"] = mcDF["mcPy"] / p
mcDF["tru_zhat"] = mcDF["mcPz"] / p
shwvars = ["shwrfitDirX","shwrfitDirY","shwrfitDirZ"]
recoDF = ak.to_dataframe(tree.arrays(shwvars, library="ak"))

recoDF["shw_xhat"] = recoDF["shwrfitDirX"]
recoDF["shw_yhat"] = recoDF["shwrfitDirY"]
recoDF["shw_zhat"] = recoDF["shwrfitDirZ"]

DF = mcDF.join(recoDF)
print("Total events:", len(leaves["event"]))
DF_electrons = DF[np.abs(DF["mcPDG"]) == 11]

lower_mask = (DF_electrons["shw_xhat"] - DF_electrons["tru_xhat"]) >= 0.1
lower_electrons = DF_electrons[lower_mask]

print("Number of electrons passing lower-quadrant cut:",len(lower_electrons))
candidate_events = lower_electrons.index.get_level_values(0).unique()

candidate_events = np.asarray(candidate_events)

print("Number of unique events passing cut:", len(candidate_events))
print("Candidate event numbers:", candidate_events)
nToPlot = min(10, len(candidate_events))
rng = np.random.default_rng(42)
selected_events = rng.choice(candidate_events,size=nToPlot,replace=False)
print("Randomly selected events:",selected_events)
def random_named():
    return random.choice(list(mcolors.CSS4_COLORS.keys()))
for iEvent in selected_events:
    nClusters = len(leaves["clusterId"][iEvent])
    print(f"Event {iEvent}: {nClusters} clusters")
    plt.figure(figsize=(8, 6))
    for iCluster in range(nClusters):
        currentCluster = (leaves["clusterId"][iEvent][iCluster])
        hitIndices = np.where(leaves["recoHitClusterId"][iEvent]== currentCluster)[0]
        hitX = leaves["recoHitX"][iEvent][hitIndices]
        hitZ = leaves["recoHitZ"][iEvent][hitIndices]

        plt.scatter(hitX,hitZ,color=random_named(),s=1)
    plt.xlabel("X")
    plt.ylabel("Z")
    plt.title(f"Event {iEvent}: X vs Z")
    plt.show
